OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Must support tool calling. Verify with: python scripts/verify_setup.py
CC_MODEL=openai/gpt-4o-mini
CC_FALLBACK_MODEL=google/gemini-2.0-flash-001
CC_TEMPERATURE=0.2
CC_MAX_TOKENS=1500
CC_REQUEST_TIMEOUT=60
CC_MAX_RETRIES=3

CC_EMBED_PROVIDER=hf
CC_EMBED_MODEL=intfloat/multilingual-e5-base

CC_DATA_DIR=./data
CC_CHROMA_DIR=./data/chroma
CC_DB_PATH=./data/career_copilot.db

CC_LOG_LEVEL=INFO
CC_LOG_JSON=true

# LangSmith would send prompts - including your CV - to a hosted service.
# CC_TRACE_REDACT_PII masks PII before any trace leaves this machine.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=career-copilot
CC_TRACE_REDACT_PII=true

CC_MONTHLY_BUDGET_USD=10.0
CC_SESSION_BUDGET_USD=1.0
CC_MAX_INPUT_CHARS=8000
CC_MAX_UPLOAD_MB=10

CC_RERANK_ENABLED=true
CC_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CC_RERANK_TOP_K=5
# Optional: fast hosted speech-to-text for the Interview page.
# Leave blank to use local faster-whisper (pip install faster-whisper).
GROQ_API_KEY=
OPENAI_API_KEY=

# ---- moderation (optional) ----
# Mistral Moderation, used as a SECOND check before a tool-capable turn and
# over external text. Without it the check is skipped and says so - it is never
# silently treated as passing. Free tier at console.mistral.ai.
MISTRAL_API_KEY=
